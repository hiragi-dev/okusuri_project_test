   'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_clear_all\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.clear_all()\\n`\n}\n\nBlockly.Blocks[\"custom_medlog_make_demo\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_MAKE_DEMO,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_make_demo\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.make_demo(${year}, ${month})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog_get_day\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_GET_DAY,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'day'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_get_day\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day = Blockly.Python.valueToCode(block, 'day', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.get_day(${year}, ${month}, ${day})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_get_month\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_GET_MONTH,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_get_month\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.get_month(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_get_month_json\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_GET_MONTH_JSON,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_get_month_json\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.get_month_json(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_count\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_COUNT,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'status'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_count\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var status = Blockly.Python.valueToCode(block, 'status', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.count(${year}, ${month}, ${status})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_to_mark\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_TO_MARK,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'status'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_to_mark\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var status = Blockly.Python.valueToCode(block, 'status', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.to_mark(${status})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_get_all\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_GET_ALL,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_get_all\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_all()`, Blockly.Python.ORDER_NONE]\n}","toolbox":"\n<category name=\"MedLog\" colour=\"#0fb1d2\" hidden=\"true\" toolboxitemid=\"custom_medlog\">\n<title text=\"MedLog\" docsLink=\"\"></title>\n<block type=\"custom_medlog_init\">\n  <value name=\"folder\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\">/flash/medlog</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_register\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"day\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"status\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_register_today\">\n  <value name=\"status\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_clear_day\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"day\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_clear_all\"/><block type=\"custom_medlog_make_demo\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2026</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">11</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_get_day\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"day\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_get_month\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_get_month_json\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2026</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">11</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_count\">\n  <value name=\"year\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"month\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"status\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_to_mark\">\n  <value name=\"status\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_medlog_get_all\"/>\n</category>\n","pyCode":"\n\"\"\"\nfile     MedLog\ntime     2026-10-14\nauthor   \nemail   \nlicense  \n\"\"\"\n\nimport os\nimport json\nimport time\n\nclass MedLog:\n    \"\"\"\n    note: ''\n    details:\n        color: '#0fb1d2'\n        link: ''\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n\n\n\n    def __init__(self, folder: str = '/flash/medlog'):\n        \"\"\"\n        label:\n            en: '%1 init, folder: %2'\n        params:\n            folder:\n                name: folder\n                type: str\n                default: /flash/medlog\n        \"\"\"\n        self._folder = folder\n        try:\n            os.mkdir(folder)\n        except OSError:\n            pass\n\n    def _path(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _path, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        return \"{}/{:04d}-{:02d}.json\".format(self._folder, int(year), int(month))\n\n    def _load(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _load, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        try:\n            with open(self._path(year, month)) as f:\n                return json.load(f)\n        except (OSError, ValueError):\n            return {}\n\n    def _save(self, year, month, data):\n        \"\"\"\n        label:\n            en: ' %1 _save, year: %2, month: %3, data: %4'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n            data:\n                name: data\n        \"\"\"\n        path = self._path(year, month)\n        tmp = path + \".tmp\"\n        with open(tmp, \"w\") as f:\n            json.dump(data, f)\n        try:\n            os.remove(path)\n        except OSError:\n            pass\n        os.rename(tmp, path)\n\n    def _days_in_month(self, year, month):\n        \"\"\"\n        label:\n            en: ' %1 _days_in_month, year: %2, month: %3'\n        params:\n            year:\n                name: year\n            month:\n                name: month\n        \"\"\"\n        year, month = int(year), int(month)\n        if month == 2:\n            leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0\n            return 29 if leap else 28\n        return 30 if month in (4, 6, 9, 11) else 31\n\n    def register(self, year: int, month: int, day: int, status: str):\n        \"\"\"\n        label:\n            en: ' %1 register, year: %2, month: %3, day: %4, status: %5'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n            day:\n                name: day\n                type: int\n                default: '0'\n            status:\n                name: status\n                type: str\n        \"\"\"\n        # Save the status for the given day. Invalid input is ignored.\n        status = str(status)\n        if status == \"\":\n            print(\"MedLog: empty status\")\n            return\n        if not 1 <= int(day) <= self._days_in_month(year, month):\n            print(\"MedLog: invalid date\", year, month, day)\n            return\n        data = self._load(year, month)\n        data[str(int(day))] = status\n        self._save(year, month, data)\n\n    def register_today(self, status: str):\n        \"\"\"\n        label:\n            en: ' %1 register_today, status: %2'\n        params:\n            status:\n                name: status\n                type: str\n        \"\"\"\n        # Save the status for today (set the clock with NTP first).\n        t = time.localtime()\n        self.register(t[0], t[1], t[2], status)\n\n    def clear_day(self, year: int = 0, month: int = 0, day: int = 0):\n        \"\"\"\n        label:\n            en: ' %1 clear_day, year: %2, month: %3, day: %4'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n            day:\n                name: day\n                type: int\n                default: '0'\n        \"\"\"\n        # Delete the record for the given day.\n        data = self._load(year, month)\n        if str(int(day)) in data:\n            del data[str(int(day))]\n            self._save(year, month, data)\n\n    def clear_all(self):\n        \"\"\"\n        label:\n            en: ' %1 clear_all'\n        \"\"\"\n        # Delete every record of every month (for testing; cannot be undone).\n        for name in os.listdir(self._folder):\n            if name.endswith(\".json\") or name.endswith(\".tmp\"):\n                try:\n                    os.remove(self._folder + \"/\" + name)\n                except OSError:\n                    pass\n\n    def make_demo(self, year: int, month: int):\n        \"\"\"\n        label:\n            en: ' %1 make_demo, year: %2, month: %3'\n        params:\n            year:\n                name: year\n                type: int\n            month:\n                name: month\n                type: int\n        \"\"\"\n        # Save demo records for every day of the month (overwrites that month).\n        year, month = int(year), int(month)\n        if not 1 <= month <= 12:\n            print(\"MedLog: invalid month\", year, month)\n            return\n        data = {}\n        for day in range(1, self._days_in_month(year, month) + 1):\n            if day % 9 == 0:\n                status = \"missed\"\n            elif day % 7 == 3:\n                status = \"taken_notified\"\n            elif day % 11 == 5:\n                status = \"notified\"\n            else:\n                status = \"taken\"\n            data[str(day)] = status\n        self._save(year, month, data)\n\n    def get_day(self, year: int = 0, month: int = 0, day: int = 0) -> str:\n        \"\"\"\n        label:\n            en: ' %1 get_day, year: %2, month: %3, day: %4'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n            day:\n                name: day\n                type: int\n                default: '0'\n        \"\"\"\n        # Status of the given day. Empty string if no record.\n        return self._load(year, month).get(str(int(day)), \"\")\n\n    def get_month(self, year: int = 0, month: int = 0) -> list:\n        \"\"\"\n        label:\n            en: ' %1 get_month, year: %2, month: %3'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n        \"\"\"\n        # Statuses from day 1 to the end of the month, in order.\n        # The first item is day 1. Days with no record are empty strings.\n        data = self._load(year, month)\n        return [data.get(str(d), \"\") for d in range(1, self._days_in_month(year, month) + 1)]\n\n    def get_month_json(self, year: int, month: int) -> str:\n        \"\"\"\n        label:\n            en: ' %1 get_month_json, year: %2, month: %3'\n        params:\n            year:\n                name: year\n                type: int\n            month:\n                name: month\n                type: int\n        \"\"\"\n        # get_month as a JSON text, e.g. [\"taken\", \"\", \"missed\", ...].\n        # Use this to send the month with MQTT.\n        return json.dumps(self.get_month(year, month))\n\n    def count(self, year: int, month: int, status: str) -> int:\n        \"\"\"\n        label:\n            en: ' %1 count, year: %2, month: %3, status: %4'\n        params:\n            year:\n                name: year\n                type: int\n                default: '0'\n            month:\n                name: month\n                type: int\n                default: '0'\n            status:\n                name: status\n                type: str\n        \"\"\"\n        # Number of days in the month that have the given status.\n        return sum(1 for v in self._load(year, month).values() if v == status)\n\n    def to_mark(self, status: str) -> str:\n        \"\"\"\n        label:\n            en: ' %1 to_mark, status: %2'\n        params:\n            status:\n                name: status\n                type: str\n        \"\"\"\n        # Convert a status to a symbol for the screen.\n        marks = {\"taken\": \"○\", \"taken_notified\": \"△\", \"notified\": \"!\", \"missed\": \"×\"}\n        # Other statuses are shown as they are. No record is \"-\".\n        if status == \"\":\n            return \"-\"\n        return marks.get(status, status)\n\n    def get_all(self) -> dict:\n        \"\"\"\n        label:\n            en: ' %1 get_all'\n        \"\"\"\n        # Every record of every month (for testing).\n        # e.g. {\"2026-10\": {\"1\": \"taken\"}, \"2026-11\": {\"3\": \"missed\"}}\n        result = {}\n        for name in sorted(os.listdir(self._folder)):\n            if name.endswith(\".json\"):\n                try:\n                    with open(self._folder + \"/\" + name) as f:\n                        result[name[:-5]] = json.load(f)\n                except (OSError, ValueError):\n                    pass\n        return result\n\n\n"}]}