": \" %1 get_month, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG_GET_MONTH_JSON\": {\n    \"en\": \" %1 get_month_json, year: %2, month: %3\"\n  },\n  \"CUSTOM_MEDLOG_COUNT\": {\n    \"en\": \" %1 count, year: %2, month: %3, status: %4\"\n  },\n  \"CUSTOM_MEDLOG_TO_MARK\": {\n    \"en\": \" %1 to_mark, status: %2\"\n  },\n  \"CUSTOM_MEDLOG_GET_ALL\": {\n    \"en\": \" %1 get_all\"\n  }\n};\n\nconst initType = 'custom_medlog_init';\nBlockly.BlockRegExpList['custom_medlog'] = {\n  regexp: new RegExp(/^custom_medlog_/),\n  code: \"from MedLog import MedLog\",\n  initBlockType: initType,\n  categoryId: 'custom_medlog',\n}\nBlockly.utils.registerLanguages(CUSTOM_MEDLOG_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MEDLOG_HUE = '#0fb1d2'\nBlockly.Msg.CUSTOM_MEDLOG = 'MedLog'\n\nBlockly.utils.getcustom_medlogOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['medlog_0', 'medlog_0']\n  ];\n  return options;\n}\n\n\nBlockly.Blocks[\"custom_medlog_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_medlogOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'medlog_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'folder'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var folder = Blockly.Python.valueToCode(block, 'folder', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MedLog(${folder})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog__path\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__PATH,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__path\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._path(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog__load\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__LOAD,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__load\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._load(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog__save\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__SAVE,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'data'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__save\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var data = Blockly.Python.valueToCode(block, 'data', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}._save(${year}, ${month}, ${data})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog__days_in_month\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG__DAYS_IN_MONTH,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog__days_in_month\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}._days_in_month(${year}, ${month})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_medlog_register\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_REGISTER,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_medlogOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        }, {\n          'type': 'input_value',\n          'name': 'month'\n        }, {\n          'type': 'input_value',\n          'name': 'day'\n        }, {\n          'type': 'input_value',\n          'name': 'status'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_medlog_register\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day = Blockly.Python.valueToCode(block, 'day', Blockly.Python.ORDER_FUNCTION_CALL);\n  var status = Blockly.Python.valueToCode(block, 'status', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.register(${year}, ${month}, ${day}, ${status})\\n`\n}\n\nBlockly.Blocks[\"custom_medlog_register_today\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MEDLOG_REGISTER_TODAY,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',